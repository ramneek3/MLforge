# Backend
APP_NAME=MLForge
APP_ENV=development
LOG_LEVEL=INFO
API_KEY=changeme-admin-api-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8080

# Database
# Local zero-setup:
# DATABASE_URL=sqlite:///./mlforge.db
DATABASE_URL=postgresql+psycopg2://mlforge:mlforge@localhost:5432/mlforge

# MLflow
# Local zero-setup:
# MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=customer-churn-classification
MLFLOW_REGISTERED_MODEL_NAME=churn-model

# Paths (relative to repo root unless absolute)
ML_CONFIG_PATH=ml/configs/config.yaml
DATA_RAW_PATH=ml/data/raw/telco_churn.csv

# Prometheus
PROMETHEUS_MULTIPROC_DIR=/tmp/mlforge-prom

# Frontend (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_KEY=changeme-admin-api-key
